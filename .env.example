# Copy to .env for the clean-clone Compose stack.
# Start it from the repository root with:
#   env -u POSTGRES_PASSWORD -u POSTGRES_USER -u POSTGRES_DB -u DATABASE_URL \
#     POSTGRES_PASSWORD=citeladder_dev_password \
#     docker compose --env-file .env -f docker-compose.yml \
#     up -d --build --force-recreate
# NOTE (gotcha 1 / invariant 11): Compose resolves POSTGRES_*/DATABASE_URL from
# the shell before this file, which is why the command unsets inherited values.
# See README.md.

# --- Postgres (interpolated into ${VAR} in docker-compose.yml) ---
POSTGRES_DB=citeladder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=citeladder_dev_password
# Host connection used by repository-root maintenance scripts.
POSTGRES_HOST=127.0.0.1
POSTGRES_HOST_PORT=55432

# --- Backend app settings (injected into the container via env_file) ---
APP_ENV=development
# Recreated automatically by reset-db.py after local development resets.
DEV_LOGIN_EMAIL=dev@citeladder.com
DEV_LOGIN_PASSWORD=replace-with-a-local-development-password
DEV_LOGIN_COUNTER_ALLOWANCE=1000000
# DATABASE_URL is derived in compose from POSTGRES_* against the db service.
JWT_SECRET_KEY=replace-with-a-64-byte-random-secret-for-local-dev-only-000000
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
ENCRYPTION_KEY=replace-with-a-32-byte-min-random-secret-local-dev-only
FRONTEND_URL=http://127.0.0.1:3000
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUSTED_PROXY_CIDRS=

# --- Optional observability (Pydantic Logfire) ---
# Both flags are required: telemetry stays a no-op unless ENABLED is true AND a
# write token is present, so a missing token can never break startup or tests.
LOGFIRE_ENABLED=false
# Project write token. NEVER commit a real value - keep it in .env (gitignored)
# or the deployment secret store. Mint one with:
#   uvx logfire --base-url='https://logfire-us.pydantic.dev' auth
#   uvx logfire --base-url='https://logfire-us.pydantic.dev' projects use \
#     --org '<org>' '<project>'
LOGFIRE_TOKEN=
# Base service name. Each process appends its own role suffix, so the API
# reports as citeladder-api and the workers as citeladder-<worker>.
LOGFIRE_SERVICE_NAME=citeladder
# Defaults to APP_ENV when blank.
LOGFIRE_ENVIRONMENT=
# Region ingest endpoint (US by default; use logfire-eu.pydantic.dev for EU).
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
# Tests stay locally observable unless this separate opt-in is set.
LOGFIRE_ENABLED_IN_TESTS=false

# --- Default agent (assisted features: prompt generation, future content) ---
# Provider-specific keys are selected only when DEFAULT_AGENT_BASE_URL matches.
DEFAULT_AGENT_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
DEFAULT_AGENT_BASE_URL=https://api.mistral.ai/v1
DEFAULT_AGENT_MODEL=mistral-small-2603
DEFAULT_AGENT_STRUCTURED_OUTPUT_MODE=prompt_json
DEFAULT_AGENT_TIMEOUT_SECONDS=180
GENERATION_DEFAULT_COUNT=10
GENERATION_MAX_COUNT=20

# --- Content generation (content-worker service) ---
# Empty MISTRAL_API_KEY means the content provider is disabled: enqueue returns
# 409 provider_not_configured until a key is supplied.
CONTENT_PROVIDER=mistral
CONTENT_MODEL=mistral-small-latest
MISTRAL_API_KEY=
CONTENT_PROVIDER_ENDPOINT=https://api.mistral.ai/v1/chat/completions
CONTENT_REQUEST_TIMEOUT_SECONDS=60
CONTENT_MAX_OUTPUT_TOKENS=4096

# --- Site Health (development only) ---
SITE_HEALTH_DEFAULT_CAPABILITY=starter
SITE_HEALTH_STARTER_MONITORED_URL_LIMIT=50000
SITE_HEALTH_ADVANCED_CONTROLS_ENABLED=true
SITE_HEALTH_AUTOMATIC_PAGE_LIMIT=150
SITE_HEALTH_MAX_DISCOVERY_URLS=50000
SITE_HEALTH_MAX_ANALYSIS_URLS=50000
# Recover sites that reject the plain crawler transport
# through the shipped, SSRF-pinned curl-cffi rung. Patchright stays opt-in.
SITE_HEALTH_CURL_CFFI_ENABLED=true

INTEGRATION_GOOGLE_CLIENT_ID=<your-google-client-id>
INTEGRATION_GOOGLE_CLIENT_SECRET=<your-google-client-secret>
INTEGRATION_MICROSOFT_CLIENT_ID=<your-azure-app-client-id>
INTEGRATION_MICROSOFT_CLIENT_SECRET=<your-azure-client-secret>
INTEGRATION_SHOPIFY_CLIENT_ID=<your-shopify-app-client-id>
INTEGRATION_SHOPIFY_CLIENT_SECRET=<your-shopify-app-client-secret>
# HMAC key for opaque order-ref hashes on sanitized order facts (never a
# raw Shopify order id). Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
ORDER_HASH_SALT=replace-with-64-byte-random-secret

# --- Frontend (frontend service) ---
# The frontend has NO env_file: it must never receive backend secrets. Compose
# forwards only the keys below (see the `frontend` service in
# docker-compose.yml). Every one is optional; unset means the feature is simply
# not configured, never a broken build or a crashed page.
#
# NEXT_PUBLIC_* are passed as BUILD ARGS because `next build` inlines them into
# the client bundle. Changing one needs a rebuild:
#   docker compose --env-file .env -f docker-compose.yml up -d --build frontend
#
# Canonical public origin. Absolute OG/Twitter image URLs, sitemap.xml, and
# robots.txt are emitted only when this is a clean https origin (no credentials,
# no query); anything else is ignored rather than half-applied. Also read
# server-side, so it is forwarded at runtime as well as at build time.
NEXT_PUBLIC_SITE_URL=
# logo.dev publishable key for brand avatars of sites that block our crawler.
# Publishable (pk_...), not secret — it ships in the client bundle by design.
# Unset falls back to locally rendered initials.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE=
# Client API request timeout in milliseconds (invariant 1). Unset uses the
# built-in default in frontend/lib/config/operational.ts.
NEXT_PUBLIC_API_REQUEST_TIMEOUT_MS=
#
# The /demo funnel has exactly three states and all three must convert. Set the
# booking URL, or the sales address, or neither (the page converts to
# self-serve). Both are read per request, so a restart is enough — no rebuild.
# Owner-supplied; see docs/operations/razorpay-and-demo-owner-requirements.md.
DEMO_BOOKING_URL=
PUBLIC_SALES_EMAIL=
