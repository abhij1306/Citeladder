    {
      "sources": ["reset-db.py"],
      "backendTests": ["tests/unit/test_reset_db.py"]
    },
    {
      "sources": ["scripts/check.ps1", "scripts/test.ps1", "scripts/validation.json"],
      "backendTests": ["tests/unit/test_static_analysis_tools.py", "tests/unit/test_check_complexity.py"],
      "frontendTests": ["scripts/check-frontend-complexity.test.ts", "scripts/check-jscpd.test.ts"]
    },
    {
      "sources": [
        "backend/pyproject.toml",
        "backend/uv.lock",
        "backend/tests/conftest.py",
        "backend/scripts/check_complexity.py",
        "backend/scripts/complexity_policy.json"
      ],
      "backendTests": [
        "tests/unit/test_check_complexity.py",
        "tests/unit/test_static_analysis_tools.py",
        "tests/component/test_health.py"
      ]
    },
    {
      "sources": ["migrations/**", "backend/alembic.ini"],
      "backendTests": ["tests/unit/test_migration_revision_baseline.py", "tests/component/test_health.py"]
    },
    {
      "sources": [
        "frontend/package.json",
        "frontend/pnpm-lock.yaml",
        "frontend/vitest.config.ts",
        "frontend/tsconfig.json",
        "frontend/test/**"
