    },
    {
      "sources": ["frontend/next.config.ts", "frontend/eslint.config.mjs"],
      "frontendTests": ["next.config.test.ts"]
    },
    {
      "sources": [
        "frontend/scripts/check-frontend-complexity.mjs",
        "frontend/scripts/frontend_complexity_policy.json"
      ],
      "frontendTests": ["scripts/check-frontend-complexity.test.ts"]
    },
    {
      "sources": ["frontend/scripts/check-jscpd.mjs", "frontend/scripts/jscpd-baseline.json", "jscpd.json"],
      "frontendTests": ["scripts/check-jscpd.test.ts"]
