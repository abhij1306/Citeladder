{
  "backendRoots": ["backend/app"],
  "frontendRoots": ["frontend/app", "frontend/components", "frontend/lib"],
  "backendExtensions": [".py"],
  "frontendExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs"],
