{
  "name": "citeladder-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "analyze": "next experimental-analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:visual": "playwright test --config e2e/visual/visual.config.ts",
    "test:visual:update": "playwright test --config e2e/visual/visual.config.ts --update-snapshots",
    "check:complexity": "node scripts/check-frontend-complexity.mjs",
    "check:duplicates": "node scripts/check-jscpd.mjs",
    "report:duplicates:tests": "node scripts/check-jscpd.mjs --tests",
    "check:policy": "node scripts/check-design-system.mjs && node scripts/check-frontend-architecture.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check:dead-code": "knip",
    "quality:fix": "node ../scripts/quality.mjs --mode fix",
    "quality:check": "node ../scripts/quality.mjs --mode check"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jscpd": "5.0.16",
    "jsdom": "^30.0.1",
    "knip": "6.33.0",
    "msw": "^2.15.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
