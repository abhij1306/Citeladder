# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
artifacts/

# Env / secrets
.env
# Logfire CLI credentials: contains a project write token.
.logfire/
*.env
!.env.example

# Node / frontend (F1+)
node_modules/
.next/

# The root package.json only delegates to frontend/ and backend/; it declares
# no dependencies. pnpm still materializes an empty project there on any root
# `pnpm run`, and a second lockfile at the repository root would move the
# workspace root that Next.js and the tooling infer. frontend/pnpm-lock.yaml
# (not anchored here) stays tracked.
/pnpm-lock.yaml

# Local measurement sweep output (committed artifacts live in
# backend/docs/measurements/ instead)
backend/var/measurements/

# OS
.DS_Store

# Local screenshot/debug scratch scripts and their output
frontend/.*.mjs
frontend/.*.png
.runtime/
backend/.runtime/

# Coverage artifacts (measured on every run; CI uploads nothing today)
.coverage
.coverage.*
coverage.xml
htmlcov/
